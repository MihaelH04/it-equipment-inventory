@using Microsoft.AspNetCore.WebUtilities
@using ITEquipmentInventory.Models.ViewModels
@{
    var currentPage = ViewBag.CurrentPage is int current ? current : 1;
    var totalPages = ViewBag.TotalPages is int total ? total : 1;
    var totalCount = ViewBag.FilteredCount is int count ? count : 0;
    var pageSize = ViewBag.PageSize is int size && PaginationConstants.AllowedPageSizes.Contains(size)
        ? size
        : PaginationConstants.DefaultPageSize;
    var firstItem = totalCount == 0 ? 0 : (currentPage - 1) * pageSize + 1;
    var lastItem = Math.Min(currentPage * pageSize, totalCount);
    var query = Context.Request.Query.ToDictionary(x => x.Key, x => (string?)x.Value.ToString());
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var targetPath = string.Equals(currentAction, "IndexTable", StringComparison.OrdinalIgnoreCase)
        ? Url.Action("Index", controller) ?? Context.Request.Path.ToString()
        : Context.Request.Path.ToString();
    string PageUrl(int page)
    {
        query["page"] = page.ToString();
        query["pageSize"] = pageSize.ToString();
        return QueryHelpers.AddQueryString(targetPath, query);
    }
    var start = Math.Max(1, currentPage - 2);
    var end = Math.Min(totalPages, start + 4);
    start = Math.Max(1, end - 4);
}

@if (totalCount > 0)
{
    <nav class="table-pagination-shell mt-3" aria-label="Navigacija kroz stranice">
        <div class="table-pagination-summary">
            Prikaz <strong>@firstItem–@lastItem</strong> od <strong>@totalCount</strong> stavki
        </div>
        <label class="table-pagination-size">
            <span>Prikaži</span>
            <select class="form-select" aria-label="Broj stavki po stranici" onchange="var u=new URL(window.location.href);u.searchParams.set('pageSize',this.value);u.searchParams.set('page','1');window.location.href=u.toString();">
                @foreach (var allowedSize in PaginationConstants.AllowedPageSizes)
                {
                    <option value="@allowedSize" selected="@(allowedSize == pageSize)">@allowedSize</option>
                }
            </select>
            <span>po stranici</span>
        </label>
        <ul class="pagination table-pagination mb-0 flex-wrap">
            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                <a class="page-link ajax-page-link" href="@PageUrl(Math.Max(1, currentPage - 1))" aria-disabled="@(currentPage == 1)">Prethodna</a>
            </li>
            @if (start > 1)
            {
                <li class="page-item"><a class="page-link ajax-page-link" href="@PageUrl(1)">1</a></li>
                @if (start > 2) { <li class="page-item disabled"><span class="page-link">…</span></li> }
            }
            @for (var number = start; number <= end; number++)
            {
                <li class="page-item @(number == currentPage ? "active" : "")">
                    <a class="page-link ajax-page-link" href="@PageUrl(number)" aria-current="@(number == currentPage ? "page" : null)">@number</a>
                </li>
            }
            @if (end < totalPages)
            {
                @if (end < totalPages - 1) { <li class="page-item disabled"><span class="page-link">…</span></li> }
                <li class="page-item"><a class="page-link ajax-page-link" href="@PageUrl(totalPages)">@totalPages</a></li>
            }
            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                <a class="page-link ajax-page-link" href="@PageUrl(Math.Min(totalPages, currentPage + 1))" aria-disabled="@(currentPage == totalPages)">Sljedeća</a>
            </li>
        </ul>
    </nav>
}
